package javaapplication28;

import java.util.Scanner;

public class JavaApplication28 {

    public static int factorial(int n) {
        if (n <= 1) {
            return 1;
        }
        return n * factorial(n - 1);
    }

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.print("enter a non-negative whole number: ");
        int userNumber = input.nextInt();

        System.out.println("factorial(" + userNumber + ") result: " + factorial(userNumber));

        input.close();

        // PROBLEM 3
        // 1. What happens if you delete the base case entirely?
        //The method will keep calling itself without stopping. 
        //Eventually, the index will go beyond the available elements in the array, causing an error in the program.
        //2. Hand-trace "factorials(4)" with the AI's code. What does it return and why?
        // The answer will be "0" instead of "24" because the code uses zero as the stopping value. 
        //Since all the numbers are multiplied by zero, the final result will always become zero.
        //3. Which single line is wrong and what should it return instead?
        //The incorrect line is "if (n == 0) { return 0; }".
        //It should return "1" because the factorial of zero is one. This allows the other numbers to be multiplied correctly.
    }
}
